FROM cgr.dev/chainguard/wolfi-base:latest

LABEL org.opencontainers.image.source="https://github.com/obot-platform/mcp-images" \
      org.opencontainers.image.description="Node.js base image for MCP servers"

USER root

# Refresh npm's bundled dependencies within upstream's declared ranges before
# the /usr/local chown so the upgraded npm ends up owned by uid 1000.
RUN apk upgrade --no-cache && \
    apk add --no-cache make git nodejs npm pnpm && \
    npm install -g npm@12.2.1 && \
    npm_root="$(npm root -g)" && \
    npm pkg delete devDependencies --prefix "${npm_root}/npm" && \
    npm update --prefix "${npm_root}/npm" --omit=dev \
        --ignore-scripts --no-audit --no-fund && \
    npm cache clean --force && \
    mkdir -p /home/user/.npm /home/user/.local/bin && \
    chown -R 1000:0 /home/user && \
    chown -R 1000:0 /usr/local

USER 1000

ENV HOME=/home/user \
    PATH="/home/user/.local/bin:$PATH"
