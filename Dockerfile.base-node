FROM cgr.dev/chainguard/wolfi-base:latest

LABEL org.opencontainers.image.source="https://github.com/obot-platform/mcp-images" \
      org.opencontainers.image.description="Node.js base image for MCP servers"

USER root

# Toolchain and Node in a single layer. The npm update must precede the
# /usr/local chown so the upgraded npm ends up owned by uid 1000.
RUN apk add --no-cache make git nodejs npm pnpm && \
    npm install -g npm@12.0.2 && \
    npm_root="$(npm root -g)" && \
    npm pkg delete devDependencies --prefix "${npm_root}/npm" && \
    npm install --prefix "${npm_root}/npm" --no-save --omit=dev \
        --ignore-scripts --no-audit --no-fund \
        brace-expansion@5.0.9 ip-address@10.3.1 tar@7.5.21 undici@6.28.0 && \
    npm cache clean --force && \
    mkdir -p /home/user/.npm /home/user/.local/bin && \
    chown -R 1000:0 /home/user && \
    chown -R 1000:0 /usr/local

USER 1000

ENV HOME=/home/user \
    PATH="/home/user/.local/bin:$PATH"
