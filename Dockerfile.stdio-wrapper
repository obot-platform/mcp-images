ARG UV_IMAGE=ghcr.io/astral-sh/uv:latest
ARG MMMCP_IMAGE=ghcr.io/obot-platform/mmmcp:latest
FROM ${UV_IMAGE} AS uv-bin

FROM ${MMMCP_IMAGE}

USER root

# The release base pins OS packages in /etc/apk/world. Relax exact version pins
# so apk can install security updates before adding the toolchain.
# Refresh npm's bundled dependencies within upstream's declared ranges.
RUN sed -i -E 's/^([^=<>~]+)=.*$/\1/' /etc/apk/world && \
    apk upgrade --no-cache && \
    apk add --no-cache make git nodejs npm pnpm python3 && \
    npm install -g npm@12.2.1 && \
    npm_root="$(npm root -g)" && \
    npm pkg delete devDependencies --prefix "${npm_root}/npm" && \
    npm update --prefix "${npm_root}/npm" --omit=dev \
        --ignore-scripts --no-audit --no-fund && \
    npm cache clean --force && \
    mkdir -p /home/mmmcp && \
    chown -R mmmcp:mmmcp /home/mmmcp

# Copy a pinned uv binary without installing pip and its vendored dependencies.
COPY --from=uv-bin /uv /uvx /usr/local/bin/

# Enable bytecode compilation
ENV UV_COMPILE_BYTECODE=1
# Copy from the cache instead of linking since it's a mounted volume
ENV UV_LINK_MODE=copy

USER mmmcp

ENV PATH="/home/mmmcp/.local/bin:$PATH"

ENTRYPOINT ["mmmcp"]

CMD ["--help"]
