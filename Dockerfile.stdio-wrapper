FROM ghcr.io/obot-platform/mmmcp:v0.1.1

USER root

# Toolchain, Node, and Python in one layer.
RUN apk add --no-cache make git nodejs npm pnpm python3 && \
    npm install -g npm && \
    mkdir -p /home/mmmcp && \
    chown -R mmmcp:mmmcp /home/mmmcp

# Enable bytecode compilation
ENV UV_COMPILE_BYTECODE=1
# Copy from the cache instead of linking since it's a mounted volume
ENV UV_LINK_MODE=copy

USER mmmcp

ENV PATH="/home/mmmcp/.local/bin:$PATH"

RUN python -m ensurepip && pip3 install uv

ENTRYPOINT ["mmmcp"]

CMD ["--help"]
