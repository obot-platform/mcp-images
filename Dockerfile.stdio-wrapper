FROM ghcr.io/obot-platform/mmmcp:v0.1.1

USER root

# Toolchain, Node, Python, and Chromium (for Playwright/Puppeteer) in one layer.
# The chrome symlink is how Playwright's `chrome` channel finds the wolfi
# chromium build.
RUN apk add --no-cache make git nodejs npm pnpm python3 chromium && \
    npm install -g npm && \
    mkdir -p /opt/google/chrome && \
    ln -sf /usr/bin/chromium-browser /opt/google/chrome/chrome && \
    mkdir -p /home/mmmcp && \
    chown -R mmmcp:mmmcp /home/mmmcp

ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# Enable bytecode compilation
ENV UV_COMPILE_BYTECODE=1
# Copy from the cache instead of linking since it's a mounted volume
ENV UV_LINK_MODE=copy

USER mmmcp

ENV PATH="/home/mmmcp/.local/bin:$PATH"

RUN python -m ensurepip && pip3 install uv

ENTRYPOINT ["mmmcp"]

CMD ["--help"]
