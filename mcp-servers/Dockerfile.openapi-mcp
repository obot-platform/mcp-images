ARG UV_IMAGE=ghcr.io/astral-sh/uv:latest
ARG PYTHON_IMAGE=cgr.dev/chainguard/wolfi-base:latest
FROM ${UV_IMAGE} AS uv-bin
FROM ${PYTHON_IMAGE} AS runtime

RUN apk upgrade --no-cache && \
    apk add --no-cache python-3.12 ca-certificates-bundle && \
    addgroup -g 10001 app && adduser -D -H -u 10001 -G app app

WORKDIR /app
ENV PYTHONUNBUFFERED=1

FROM runtime AS builder

COPY --from=uv-bin /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
COPY openapi-mcp/pyproject.toml openapi-mcp/uv.lock ./
RUN uv sync --python /usr/bin/python3.12 --locked --no-dev --no-install-project --no-cache

FROM runtime

COPY --from=builder /app/.venv /app/.venv
COPY openapi-mcp/config.py openapi-mcp/network.py openapi-mcp/server.py ./
USER 10001:10001
ENV PORT=8080
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s \
    CMD ["/app/.venv/bin/python", "-c", "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:'+os.environ.get('PORT','8080')+'/healthz', timeout=3).close()"]
ENTRYPOINT ["/app/.venv/bin/python", "/app/server.py"]
