ARG GO_IMAGE=golang:1.27.4-alpine
ARG NODE_IMAGE=node:26-alpine
ARG MMMCP_IMAGE=ghcr.io/obot-platform/mmmcp:latest

# Rebuild the pinned release until upstream ships the Go/x/net security fixes.
# Update both GITHUB_REVISION values and GITHUB_VERSION with the manifest version.
# Keep the full UI build even though the catalog uses stdio/PAT authentication.
FROM ${NODE_IMAGE} AS github-ui
ARG GITHUB_REVISION=4bcdcdf8d7beee98c9448e73e257308280924cc4
RUN apk add --no-cache git && \
    git clone https://github.com/github/github-mcp-server.git /src && \
    cd /src && git checkout "${GITHUB_REVISION}"
WORKDIR /src/ui
RUN npm ci && npm run build

FROM ${GO_IMAGE} AS binary
ARG GITHUB_VERSION=2.1.0
ARG GITHUB_REVISION=4bcdcdf8d7beee98c9448e73e257308280924cc4
ENV GOTOOLCHAIN=local
WORKDIR /src
COPY --from=github-ui /src /src
RUN go get golang.org/x/net@v0.62.0 && \
    CGO_ENABLED=0 go build -ldflags="-s -w -X main.version=${GITHUB_VERSION} -X main.commit=${GITHUB_REVISION}" \
        -o /server/github-mcp-server ./cmd/github-mcp-server

FROM ${MMMCP_IMAGE}

COPY --from=binary /server/github-mcp-server .

USER root

# The release base pins OS packages in /etc/apk/world. Relax exact version pins
# so apk can install security updates.
RUN sed -i -E 's/^([^=<>~]+)=.*$/\1/' /etc/apk/world && \
    apk upgrade --no-cache

RUN cat > mmmcp.yaml <<'EOF'
servers:
  - name: GitHub
    command: ./github-mcp-server
    args: [stdio]
    env:
      GITHUB_PERSONAL_ACCESS_TOKEN: ${GITHUB_PERSONAL_ACCESS_TOKEN}
      GITHUB_TOOLSETS: ${GITHUB_TOOLSETS}
      GITHUB_DYNAMIC_TOOLSETS: ${GITHUB_DYNAMIC_TOOLSETS}
      GITHUB_HOST: ${GITHUB_HOST}
EOF

RUN chown 1000 mmmcp.yaml

ENTRYPOINT ["mmmcp"]

CMD ["--listen", ":8099", "--config", "./mmmcp.yaml"]

USER 1000
