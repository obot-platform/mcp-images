ARG NODE_IMAGE=node:alpine
FROM ${NODE_IMAGE} AS builder
WORKDIR /app

# Install git for cloning
RUN apk add --no-cache git

# Clone Tableau MCP v4.7.1 at a specific commit for reproducibility
ARG TABLEAU_MCP_REPO=https://github.com/tableau/tableau-mcp.git
ARG TABLEAU_MCP_COMMIT=aa5e8ba8c543e3f2a71b051055fab9bf58484c14
RUN git clone ${TABLEAU_MCP_REPO} . && \
    git checkout ${TABLEAU_MCP_COMMIT}

RUN npm ci --ignore-scripts
RUN npm run build

FROM ${NODE_IMAGE} AS runner
WORKDIR /app

COPY --from=builder /app/package.json /app/package-lock.json ./
RUN npm ci --omit=dev --production --ignore-scripts && \
    npm cache clean --force

COPY --from=builder /app/build ./build

RUN chmod +x build/index.js

ENV TRANSPORT=http
ENV PORT=8098

CMD ["node", "build/index.js"]
