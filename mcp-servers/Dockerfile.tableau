ARG NODE_IMAGE=node:alpine
FROM ${NODE_IMAGE} AS builder
WORKDIR /app

# Install git for cloning
RUN apk add --no-cache git

# Clone Tableau MCP v4.8.1 at a specific commit for reproducibility
ARG TABLEAU_MCP_REPO=https://github.com/tableau/tableau-mcp.git
ARG TABLEAU_MCP_COMMIT=368c740e6ff9b759128fcb4a79b9a7927ebdb28c
RUN git clone ${TABLEAU_MCP_REPO} . && \
    git checkout ${TABLEAU_MCP_COMMIT}

# Refresh affected transitive dependencies within upstream's compatible ranges.
# The resulting lockfile is also used by the production stage below.
RUN npm update --ignore-scripts \
    axios body-parser fast-uri hono @hono/node-server ip-address qs @xmldom/xmldom
RUN npm run build

FROM ${NODE_IMAGE} AS runner
WORKDIR /app

COPY --from=builder /app/package.json /app/package-lock.json ./
RUN apk upgrade --no-cache && \
    npm ci --omit=dev --ignore-scripts && \
    npm cache clean --force && \
    rm -rf /usr/local/lib/node_modules/npm /opt/yarn-* && \
    rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/yarn /usr/local/bin/yarnpkg

COPY --from=builder /app/build ./build

RUN chmod +x build/index.js

ENV TRANSPORT=http
ENV PORT=8098

CMD ["node", "build/index.js"]
