ARG BASE_IMAGE=ghcr.io/obot-platform/mcp-images/base-python:main
ARG MMMCP_IMAGE=ghcr.io/obot-platform/mmmcp:v0.1.1

FROM ${MMMCP_IMAGE} AS mmmcp
FROM ${BASE_IMAGE}

ARG MCP_PACKAGE
ARG MCP_VERSION
ARG MCP_CONSTRAINTS=""
ARG MCP_OVERRIDES=""

USER 1000

# Install the MCP package using uv with optional extra requirements and
# dependency overrides. Overrides let us patch vulnerable transitive pins while
# keeping the upstream package version stable.
RUN set -- uv tool install "${MCP_PACKAGE}@${MCP_VERSION}"; \
    for constraint in $MCP_CONSTRAINTS; do \
        set -- "$@" --with "$constraint"; \
    done; \
    if [ -n "$MCP_OVERRIDES" ]; then \
        overrides_file="$(mktemp)"; \
        for override in $MCP_OVERRIDES; do \
            printf '%s\n' "$override" >> "$overrides_file"; \
        done; \
        set -- "$@" --overrides "$overrides_file"; \
    fi; \
    "$@"; \
    if [ -n "${overrides_file:-}" ]; then rm -f "$overrides_file"; fi

USER root

# Add the transport wrapper after the application so package installation can
# never replace the wrapper executable or its runtime configuration.
COPY --from=mmmcp /usr/local/bin/mmmcp /usr/local/bin/
COPY scripts/mmmcp.sh /usr/local/bin/mmmcp.sh

RUN apk add --no-cache jq && \
    chmod +x /usr/local/bin/mmmcp.sh && \
    mkdir -p /home/user/.local/bin && \
    chown -R 1000:0 /home/user /usr/local

USER 1000

ENV HOME=/home/user \
    PATH="/home/user/.local/bin:$PATH"

WORKDIR /home/user

ENTRYPOINT ["mmmcp.sh"]
